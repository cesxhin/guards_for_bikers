  },
  "keywords": [],
  "author": "cesxhin",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "async-lock": "1.4.1",
    "axios": "1.18.1",
    "canvas": "3.2.3",
    "chart.js": "4.5.1",
    "chartjs-adapter-luxon": "1.3.1",
    "cron": "4.4.0",
    "dockerode": "^5.0.1",
    "geolib": "3.3.14",
    "lodash": "4.18.1",
    "luxon": "3.7.2",
    "mongoose": "9.7.4",
    "node-cache": "5.1.2",
    "node-telegram-bot-api": "1.2.0",
    "winston": "3.19.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/async-lock": "1.4.2",
    "@types/axios": "0.14.4",
    "@types/dockerode": "^4.0.1",
    "@types/lodash": "4.17.24",
    "@types/luxon": "3.7.2",
    "@types/node-cache": "4.2.5",
    "@types/node-telegram-bot-api": "0.64.15",
    "@types/winston": "2.4.4",
    "@typescript-eslint/parser": "8.64.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.7.0",
    "globals": "17.7.0",
    "mongodb-memory-server": "11.2.0",
    "node-gyp": "12.2.0",
    "tsup": "8.5.1",
    "tsx": "4.23.1",
    "typescript": "6.0.2",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.11"
