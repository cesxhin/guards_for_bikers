{
  "name": "src",
  "version": "2.1.1",
  "main": "index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "tsx index.ts",
    "panel-control": "tsx ./utility/index.ts",
    "typecheck": "npx tsgo",
    "build": "tsup",
    "build-panel-control": "tsup --config panel-control.tsup.config.ts",
    "eslint": "eslint",
    "eslint-fix": "eslint --fix",
